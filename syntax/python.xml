<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language SYSTEM "language.dtd">
<language
  name="Python"
  section="Sources"
  extensions="*.py;*.pyw"
  version="1"
  kateversion="5.0"
  priority="10"
  author="Louis Ledoux"
  license="MIT">

  <highlighting>
    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">
        <DetectSpaces/>

        <RegExpr attribute="Comment" context="#stay" String="#.*$"/>

        <StringDetect attribute="String" context="TripleDoubleString" String="&quot;&quot;&quot;"/>
        <StringDetect attribute="String" context="TripleSingleString" String="'''"/>
        <DetectChar attribute="String" context="DoubleString" char="&quot;"/>
        <DetectChar attribute="String" context="SingleString" char="'"/>

        <keyword attribute="Import" context="#stay" String="imports"/>
        <keyword attribute="Control Flow" context="#stay" String="controlFlow"/>
        <keyword attribute="Keyword" context="#stay" String="keywords"/>
        <keyword attribute="Data Type" context="#stay" String="types"/>
        <keyword attribute="BuiltIn" context="#stay" String="builtins"/>
        <keyword attribute="Constant" context="#stay" String="constants"/>
        <keyword attribute="Operator" context="#stay" String="wordOperators"/>

        <RegExpr attribute="Annotation" context="#stay" String="@[A-Za-z_][A-Za-z0-9_.]*"/>

        <RegExpr attribute="Float" context="#stay" String="\b([0-9]+\.[0-9]*|\.[0-9]+)([eE][+-]?[0-9]+)?\b"/>
        <RegExpr attribute="Float" context="#stay" String="\b[0-9]+[eE][+-]?[0-9]+\b"/>
        <RegExpr attribute="BaseN" context="#stay" String="\b0[xX][0-9A-Fa-f_]+\b"/>
        <RegExpr attribute="BaseN" context="#stay" String="\b0[bB][01_]+\b"/>
        <RegExpr attribute="BaseN" context="#stay" String="\b0[oO][0-7_]+\b"/>
        <RegExpr attribute="DecVal" context="#stay" String="\b[0-9][0-9_]*\b"/>

        <RegExpr attribute="Function" context="#stay" String="\b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()"/>
        <RegExpr attribute="Variable" context="#stay" String="\b[A-Za-z_][A-Za-z0-9_]*\b"/>

        <AnyChar attribute="Operator" context="#stay" String="+-*/%=&amp;|^~&lt;&gt;!:,.;()[]{}"/>
      </context>

      <context name="DoubleString" attribute="String" lineEndContext="#pop">
        <RegExpr attribute="Char" context="#stay" String="\\."/>
        <DetectChar attribute="String" context="#pop" char="&quot;"/>
      </context>

      <context name="SingleString" attribute="String" lineEndContext="#pop">
        <RegExpr attribute="Char" context="#stay" String="\\."/>
        <DetectChar attribute="String" context="#pop" char="'"/>
      </context>

      <context name="TripleDoubleString" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Char" context="#stay" String="\\."/>
        <StringDetect attribute="String" context="#pop" String="&quot;&quot;&quot;"/>
      </context>

      <context name="TripleSingleString" attribute="String" lineEndContext="#stay">
        <RegExpr attribute="Char" context="#stay" String="\\."/>
        <StringDetect attribute="String" context="#pop" String="'''"/>
      </context>
    </contexts>

    <itemDatas>
      <itemData name="Normal Text" defStyleNum="dsNormal"/>
      <itemData name="Keyword" defStyleNum="dsKeyword"/>
      <itemData name="Control Flow" defStyleNum="dsControlFlow"/>
      <itemData name="Import" defStyleNum="dsImport"/>
      <itemData name="Data Type" defStyleNum="dsDataType"/>
      <itemData name="BuiltIn" defStyleNum="dsBuiltIn"/>
      <itemData name="Function" defStyleNum="dsFunction"/>
      <itemData name="Variable" defStyleNum="dsVariable"/>
      <itemData name="Annotation" defStyleNum="dsAnnotation"/>
      <itemData name="Constant" defStyleNum="dsConstant"/>
      <itemData name="BaseN" defStyleNum="dsBaseN"/>
      <itemData name="DecVal" defStyleNum="dsDecVal"/>
      <itemData name="Float" defStyleNum="dsFloat"/>
      <itemData name="String" defStyleNum="dsString"/>
      <itemData name="Char" defStyleNum="dsChar"/>
      <itemData name="Comment" defStyleNum="dsComment"/>
      <itemData name="Operator" defStyleNum="dsOperator"/>
    </itemDatas>

    <list name="imports">
      <item>import</item>
      <item>from</item>
      <item>as</item>
    </list>

    <list name="controlFlow">
      <item>if</item>
      <item>elif</item>
      <item>else</item>
      <item>for</item>
      <item>while</item>
      <item>try</item>
      <item>except</item>
      <item>finally</item>
      <item>with</item>
      <item>match</item>
      <item>case</item>
      <item>return</item>
      <item>break</item>
      <item>continue</item>
    </list>

    <list name="keywords">
      <item>def</item>
      <item>class</item>
      <item>lambda</item>
      <item>global</item>
      <item>nonlocal</item>
      <item>del</item>
      <item>assert</item>
      <item>async</item>
      <item>await</item>
      <item>pass</item>
      <item>raise</item>
      <item>yield</item>
    </list>

    <list name="types">
      <item>bool</item>
      <item>bytes</item>
      <item>bytearray</item>
      <item>complex</item>
      <item>dict</item>
      <item>float</item>
      <item>frozenset</item>
      <item>int</item>
      <item>list</item>
      <item>memoryview</item>
      <item>object</item>
      <item>range</item>
      <item>set</item>
      <item>slice</item>
      <item>str</item>
      <item>tuple</item>
      <item>type</item>
    </list>

    <list name="builtins">
      <item>abs</item>
      <item>all</item>
      <item>any</item>
      <item>enumerate</item>
      <item>filter</item>
      <item>getattr</item>
      <item>hasattr</item>
      <item>isinstance</item>
      <item>issubclass</item>
      <item>len</item>
      <item>map</item>
      <item>max</item>
      <item>min</item>
      <item>next</item>
      <item>open</item>
      <item>print</item>
      <item>repr</item>
      <item>reversed</item>
      <item>sorted</item>
      <item>sum</item>
      <item>super</item>
      <item>vars</item>
      <item>zip</item>
    </list>

    <list name="constants">
      <item>True</item>
      <item>False</item>
      <item>None</item>
      <item>NotImplemented</item>
      <item>Ellipsis</item>
    </list>

    <list name="wordOperators">
      <item>and</item>
      <item>or</item>
      <item>not</item>
      <item>in</item>
      <item>is</item>
    </list>
  </highlighting>
</language>
